# Casper Academy: one address per page, clean URLs, old links kept alive.
# WordPress in /blog/ has its own .htaccess and is not affected by the page rules below.

Options -MultiViews
DirectoryIndex index.php
RewriteEngine On

# 1. Always https://www.casperacademy.in
# (behind Hostinger's CDN the original scheme arrives in X-Forwarded-Proto, so check both to avoid loops)
RewriteCond %{HTTP_HOST} ^casperacademy\.in$ [NC]
RewriteRule ^(.*)$ https://www.casperacademy.in/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteCond %{HTTP:CF-Visitor} !https [NC]
RewriteRule ^(.*)$ https://www.casperacademy.in/$1 [R=301,L]

# 2. /index.php, /index.html (GitHub Pages preview stub) and /index -> /
RewriteRule ^index(\.php|\.html)?$ https://www.casperacademy.in/ [R=301,L]
RewriteRule ^(preview|tools|wp-theme|dist|partials|data)(/.*)?$ - [F,L]
RewriteRule ^(router\.php|README\.md|\.git.*)$ - [F,L]
RewriteRule (^|/)(error_log|.*\.log|.*\.zip|.*\.sql|\.DS_Store|tidio-pass|htaccess\..*)$ - [F,L]

# 3. Old page addresses -> new ones (keeps Google rankings and old links working)
RewriteRule ^contact-us(\.php)?$ https://www.casperacademy.in/contact [R=301,L]
RewriteRule ^frequently(\.php)?$ https://www.casperacademy.in/faq [R=301,L]
RewriteRule ^services(\.php)?$ https://www.casperacademy.in/about [R=301,L]
RewriteRule ^(course|courses)(\.php)?$ https://www.casperacademy.in/#courses [R=301,NE,L]
RewriteRule ^spoken-english(\.php)?$ https://www.casperacademy.in/communicative-english [R=301,L]
RewriteRule ^python(\.php)?$ https://www.casperacademy.in/ [R=301,L]
RewriteRule ^ielts-score-calculator(\.php)?$ https://www.casperacademy.in/ielts#score-calculator [R=301,NE,L]
# Old keyword pages from the footer, merged into the course pages
RewriteRule ^(ielts-ernakulam|ielts-training-centre-in-kochi|ielts-institute-in-kochi|ielts-training-centre-in-kerala|ielts-exam-registration-in-kochi|online-ielts-coaching|ielts-coaching-centre-kochi|ielts-coaching-in-kochi|best-ielts-coaching-in-ernakulam|top-ielts-coaching-centre-in-kochi|best-ielts-coaching-centre-in-kochi|ielts-institute-in-kerala|ielts-coaching-institutes-in-kochi|best-ielts-coaching-centre-in-kerala|ielts-coaching-centre-in-kerala|your-pathway-to-success-in-ielts-education|ielts-exam-registration|top-ielts-coaching-in-kochi-ernakulam|top-ielts-coaching-kochi-ernakulam)(\.php)?$ https://www.casperacademy.in/ielts [R=301,NC,L]
RewriteRule ^pte-coaching-centre-kochi(\.php)?$ https://www.casperacademy.in/pte [R=301,L]
# OET and German courses are no longer offered: their pages go to the homepage
RewriteRule ^(oet|oet-kochi|best-oet-coaching-centre-in-kochi|german-language|german-coaching-in-kochi|german-language-course-in-kochi|german-language-institute-in-ernakulam)(\.php)?$ https://www.casperacademy.in/ [R=301,L]

# 4. Any other /page.php in the site root -> /page
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{THE_REQUEST} \s/([a-z0-9-]+)\.php[\s?] [NC]
RewriteRule ^ https://www.casperacademy.in/%1 [R=301,L]

# 5. Serve /page from page.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteCond $1 !^router$
RewriteRule ^([a-z0-9-]+)/?$ $1.php [L]

ErrorDocument 404 /404.php

# Caching for static files
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
